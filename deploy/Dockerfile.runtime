# Build this from the directory produced by scripts/package-runtime.mjs.
ARG NODE_IMAGE=node:26.13.0-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9
FROM ${NODE_IMAGE} AS layers
WORKDIR /staging
COPY . ./
RUN mkdir -p /runtime/dependencies /runtime/fonts/public /runtime/app \
    && mv node_modules /runtime/dependencies/node_modules \
    && mv public/fonts /runtime/fonts/public/fonts \
    && cp -a . /runtime/app/ \
    && rm /runtime/app/Dockerfile \
    && find /runtime/dependencies /runtime/fonts -depth -exec touch -h -d '@0' {} +

FROM ${NODE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 DB_PATH=/data/wind-blog.db
COPY --link --from=layers --chown=1000:1000 /runtime/dependencies/ ./
COPY --link --from=layers --chown=1000:1000 /runtime/fonts/ ./
COPY --link --from=layers --chown=1000:1000 /runtime/app/ ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]

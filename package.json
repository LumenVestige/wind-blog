{
  "name": "wind-blog",
  "version": "0.1.0",
  "private": true,
  "description": "Wind Blog — standalone personal blog platform (Next.js + SQLite), Obsidian-plugin compatible",
  "scripts": {
    "fonts:prepare": "node scripts/prepare-fonts.mjs",
    "postinstall": "npm run fonts:prepare",
    "predev": "npm run fonts:prepare",
    "prebuild": "npm run fonts:prepare",
    "dev": "next dev",
    "setup-agent-skill": "node scripts/dev/agent-skill.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx src/db/seed.ts",
    "migrate": "sh scripts/migrate.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/maple-mono": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "jose": "^6.0.10",
    "katex": "^0.19.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.475.0",
    "lxgw-wenkai-webfont": "^1.7.0",
    "markdown-it": "^14.1.0",
    "marked": "^18.1.0",
    "mermaid": "^12.2.0",
    "next": "^15.5.27",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.14.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.4",
    "viewerjs": "^1.11.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sanitize-html": "^2.13.0",
    "@types/turndown": "^5.0.6",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.30"
  },
  "engines": {
    "node": ">=22.13"
  }
}

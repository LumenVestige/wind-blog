# Wind Blog environment
# Copy to .env.local and edit.

# JWT signing secret (>= 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=

# SQLite database file path (relative to project root or absolute)
DB_PATH=./data/wind-blog.db

# Public base URL of this site (used for absolute links)
PUBLIC_SITE_URL=
# Optional: trust only a proxy which overwrites forwarded headers
TRUST_PROXY=0
# Unique per instance when deploying several sites on one host
INSTANCE_ID=

# Optional db:seed bootstrap (only before setup; password >= 12 characters)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Obsidian plugin publish token (POST /api/user/blog/obsidian-plugin/publish)
CWXU_OBSIDIAN_PUBLISH_TOKEN=
